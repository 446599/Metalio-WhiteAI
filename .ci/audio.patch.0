diff --git a/main/Kconfig.projbuild b/main/Kconfig.projbuild
new file mode 100644
index 0000000000000000000000000000000000000000..88009f67a6277a660031882be8d6aca1cc670b4e
--- /dev/null
+++ b/main/Kconfig.projbuild
@@ -0,0 +1,14 @@
+menu "WhiteAI product features"
+    config WHITEAI_EXPERIMENTAL_BLE_DISCOVERY
+        bool "Experimental BLE discovery (not audio-safe product firmware)"
+        depends on BT_NIMBLE_ENABLED
+        default n
+        help
+            Link the ESP32 BLE controller and enable discovery in quick controls.
+            This consumed about 20 KiB additional shared internal RAM on the
+            affected S3 build, even before the first scan, preventing allocation
+            of the 24 KiB audio playback stack. Keep disabled for the product.
+            This is independent of the external UART/I2S Bluetooth audio module.
+            Enabling requires a separately measured memory/stack budget and
+            on-device TTS, alarm and BLE coexistence validation.
+endmenu
diff --git a/main/audio/stack_watermark.h b/main/audio/stack_watermark.h
new file mode 100644
index 0000000000000000000000000000000000000000..c43cc871cef0ec386bb494e7ae61c495459ec2d6
--- /dev/null
+++ b/main/audio/stack_watermark.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <limits>
+
+namespace audio {
+// Keep the lowest observed free-stack value across task lifetimes. UINT32_MAX
+// means unmeasured internally: zero is a valid and important low-water sample.
+class StackWatermark {
+public:
+    void Observe(uint32_t bytes) {
+        auto old = minimum_.load(std::memory_order_relaxed);
+        while (bytes < old && !minimum_.compare_exchange_weak(
+            old, bytes, std::memory_order_relaxed, std::memory_order_relaxed)) {}
+    }
+    uint32_t FreeBytes() const {
+        const auto value = minimum_.load(std::memory_order_relaxed);
+        return value == kUnmeasured ? 0 : value;
+    }
+private:
+    static constexpr uint32_t kUnmeasured = std::numeric_limits<uint32_t>::max();
+    std::atomic<uint32_t> minimum_{kUnmeasured};
+};
+}
